{
  "name": "cadmos-panic-recovery-open",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "description": "Open-source emergency recovery toolkit for Cadmos users",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:frontend",
    "build:frontend": "node ./scripts/buildFrontend.mjs",
    "serve": "npm run build:frontend && python3 -m http.server 8080 -d dist",
    "generate": "node ./scripts/generateRecoveryPlan.mjs",
    "check:frontend": "npm run build:frontend && node --test ./test/frontend-build.test.mjs ./test/recovery-planning-safety.test.mjs ./test/recovery-verification.test.mjs ./test/worker-security.test.mjs ./test/worker-routing.test.mjs ./test/deployment-verification.test.mjs",
    "check:deployment": "node ./scripts/checkDeployedSecurity.mjs",
    "test": "npm run check:frontend",
    "build:contracts": "forge build"
  },
  "dependencies": {
    "viem": "2.55.15"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
