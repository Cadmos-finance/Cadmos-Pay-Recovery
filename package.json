{
  "name": "cadmos-panic-recovery-open",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "description": "Open-source emergency recovery toolkit for Cadmos users",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:frontend",
    "build:frontend": "node ./scripts/buildFrontend.mjs",
    "serve": "npm run build:frontend && python3 -m http.server 8080 -d dist",
    "generate": "node --experimental-strip-types ./scripts/generateRecoveryPayloads.ts ./scripts/recovery-config.example.json",
    "check:frontend": "npm run build:frontend && node --test ./test/frontend-build.test.mjs",
    "test": "npm run check:frontend",
    "build:contracts": "forge build"
  },
  "dependencies": {
    "viem": "2.55.15"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
